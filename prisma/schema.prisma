generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

model User {
  id               String       @id @default(cuid())
  staffCode        String?      @unique
  name             String
  email            String?      @unique
  passwordHash     String?
  age              Int?
  gender           String?
  photoData        String?
  role             Role
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  attendance       Attendance[] @relation("StaffAttendance")
  markedAttendance Attendance[] @relation("MarkedBy")
  auditLogs        AuditLog[]   @relation("Actor")
  fingerprintEnrollments FingerprintEnrollment[]
  fingerprintRequests FingerprintEnrollmentRequest[] @relation("EnrollmentRequestedBy")
  fingerprintEnrollmentRequestsForStaff FingerprintEnrollmentRequest[] @relation("EnrollmentForStaff")
}

model BiometricDevice {
  id           String   @id
  name         String
  model        String?
  serialNumber String?
  connectionType String?
  host         String?
  port         Int?
  enabled      Boolean  @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  enrollments  FingerprintEnrollment[]
  requests     FingerprintEnrollmentRequest[]
  commands     BiometricCommand[]
}

model FingerprintEnrollment {
  id           String   @id @default(cuid())
  staffId      String
  deviceId     String
  deviceUserId String
  fingerLabel  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  staff        User @relation(fields: [staffId], references: [id], onDelete: Cascade)
  device       BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@unique([deviceId, deviceUserId])
  @@index([staffId])
}

model FingerprintEnrollmentRequest {
  id            String   @id @default(cuid())
  staffId       String
  requestedById String
  deviceId      String
  fingerLabel   String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  expiresAt     DateTime?
  completedAt   DateTime?
  staff         User @relation("EnrollmentForStaff", fields: [staffId], references: [id], onDelete: Cascade)
  requestedBy   User @relation("EnrollmentRequestedBy", fields: [requestedById], references: [id])
  device        BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@index([status])
}

model BiometricCommand {
  id           String   @id @default(cuid())
  deviceId     String
  type         String
  deviceUserId String?
  staffCode    String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  completedAt  DateTime?
  details      String?
  device       BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
}

model Attendance {
  id         String           @id @default(cuid())
  staffId    String
  markedById String?
  date       DateTime
  checkIn   DateTime?
  checkOut  DateTime?
  lunchStart DateTime?
  lunchSeconds Int @default(0)
  status     AttendanceStatus @default(ABSENT)
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  staff      User             @relation("StaffAttendance", fields: [staffId], references: [id])
  markedBy   User?            @relation("MarkedBy", fields: [markedById], references: [id])

  @@unique([staffId, date])
  @@index([date])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("Actor", fields: [actorId], references: [id])

  @@index([createdAt])
}